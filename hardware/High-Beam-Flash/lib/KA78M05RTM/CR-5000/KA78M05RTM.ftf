(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r285_125
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 125000)
            (height 285000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad r650_555
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 555000)
            (height 650000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r285_125
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r285_125))
          (noconnect (pad r285_125))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r285_125))
          (noconnect (pad r285_125))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r285_125))
          (noconnect (pad r285_125))
        )
      )
      (padstack r650_555
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r650_555))
          (noconnect (pad r650_555))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r650_555))
          (noconnect (pad r650_555))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r650_555))
          (noconnect (pad r650_555))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "KA78M05RTM"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -330000 -305000
                        (width 10000)
                      )
                      (pt 330000 -305000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 330000 -305000
                        (width 10000)
                      )
                      (pt 330000 305000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 330000 305000
                        (width 10000)
                      )
                      (pt -330000 305000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -330000 305000
                        (width 10000)
                      )
                      (pt -330000 -305000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 430000 517500)
                    (pt 430000 -790000)
                    (pt -430000 -790000)
                    (pt -430000 517500)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -330000 -260000
                        (width 20000)
                      )
                      (pt -330000 -300000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -330000 -300000
                        (width 20000)
                      )
                      (pt -330000 -305000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -330000 -305000
                        (width 20000)
                      )
                      (pt 330000 -305000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 330000 -305000
                        (width 20000)
                      )
                      (pt 330000 -260000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -228000 -750000
                        (width 10000)
                      )
                      (pt -228000 -750000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -228000 -750000
                            (width 10000)
                          )
                        )
                        (center -0 1073741824)
                        (end
                          (pt -228000 -740000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt -228000 -740000
                            (width 10000)
                          )
                        )
                        (center -0 -1073741824)
                        (end
                          (pt -228000 -750000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -228000 -547500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -228000 -547500)
                  (angle 0)
                  (padstackGroup default (padstack r285_125))
                )
              )
            )
          )
          (pin 2
            (pt 228000 -547500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 228000 -547500)
                  (angle 0)
                  (padstackGroup default (padstack r285_125))
                )
              )
            )
          )
          (pin 3
            (pt 0 92500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 92500)
                  (angle 0)
                  (padstackGroup default (padstack r650_555))
                )
              )
            )
          )
        ); End of toeprint
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

